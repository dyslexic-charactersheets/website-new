{{#> Base title="Pathfinder - Dyslexic Character Sheets"}}

{{#> BuildLayout theme="adventurer"}}
  {{#> Left }}
    {{#> Pane bg="parchment" shadow="left"}}
      {{> MenuButtons}}

      {{#> Switch 
        id='switch-milestones' 
        current='start'
        var="#build-form.pick | default 'character'"
      }}

        {{#> SwitchCase value='character'}}
          {{> Milestones
            id="milestones-character"
            current="start"
            scroll-target="#slides-character"
            milestones=(array 
              (item milestone="start" title="Start" scrollto="slides-character-slide-start")
              (item milestone="class" title="Class" scrollto="slides-character-slide-class")
              (item milestone="options" title="Options" scrollto="slides-character-slide-options")
              (item milestone="picture" title="Picture" scrollto="slides-character-slide-picture")
              (item milestone="download" title="Download" scrollto="slides-character-slide-download")
            )
          }}
        {{/SwitchCase}}

        {{#> SwitchCase value='gm'}}
          {{> Milestones
            id="milestones-gm"
            current="start"
            scroll-target="#slides-character"
            milestones=(array
              (item milestone="start" title="Start" scrollto="slides-character-slide-start")
              (item milestone="gm" title="GM" scrollto="slides-character-slide-gm")
              (item milestone="gm-options" title="Options" scrollto="slides-character-slide-gm-options")
              (item milestone="gm-download" title="Download" scrollto="slides-character-slide-gm-download")
            )
          }}
        {{/SwitchCase}}

        {{#> SwitchCase value='kingdom'}}
          {{> Milestones
            id="milestones-kingdom"
            current="start"
            scroll-target="#slides-character"
            milestones=(array
              (item milestone="start" title="Start" scrollto="slides-character-slide-start")
              (item milestone="kingdom" title="Kingdom" scrollto="slides-character-slide-kingdom")
              (item milestone="kingdom-download" title="Download Kingdom" scrollto="slides-character-slide-kingdom-download")
            )
          }}
        {{/SwitchCase}}

        {{#> SwitchCase value='mini'}}
          {{> Milestones
            id="milestones-mini"
            current="start"
            scroll-target="#slides-character"
            milestones=(array
              (item milestone="start" title="Start" scrollto="slides-character-slide-start")
              (item milestone="mini" title="Map Figure" scrollto="slides-character-slide-mini")
              (item milestone="mini-download" title="Download" scrollto="slides-character-slide-mini-download")
            )
          }}
        {{/SwitchCase}}

      {{/Switch}}
    {{/Pane}}
  {{/Left}}

  {{#> Right dark=true}}
    {{#> Pane bg="red"}}
      {{> BuildFormClassic game="pathfinder" gameData=pathfinder1 logo="/images/pathfinder.png" }}
    {{/Pane}}
  {{/Right}}
{{/BuildLayout}}

{{> PortraitMenu iconics=assets.iconics }}
{{> LogoMenu logos=assets.logos }}
{{> NewCharacterMenu }}

{{/Base}}
